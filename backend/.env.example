# SpendFlow backend environment.
# Copy to `.env` and adjust. Never commit the real `.env`.

# SQLite database location. `file:` prefix is optional; resolved relative to backend/.
DATABASE_URL=file:./dev.db

# Better Auth — required. Any long random string (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=dev-secret-change-me-in-production-please

# Base URL where this backend is served. Used by Better Auth for cookies/redirects.
BETTER_AUTH_URL=http://localhost:8787

# Optional: trusted frontend origin for CORS (dev). Comma-separated.
# Must match the origin the Next.js dev server is served from so the browser
# sends credentials cross-origin (httpOnly session cookie).
FRONTEND_ORIGIN=http://localhost:3000

# Session lifetime in seconds (default 7 days). Mirrors Better Auth's default.
SESSION_EXPIRES_IN=604800

# Port the Hono server listens on.
PORT=8787
