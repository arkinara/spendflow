# SpendFlow backend environment.
# Copy to `.env` and adjust. Never commit the real `.env`.

# SQLite database location. `file:` prefix is optional; resolved relative to backend/.
DATABASE_URL=file:./dev.db

# Better Auth — required. Any long random string (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=dev-secret-change-me-in-production-please

# Base URL where this backend is served. Used by Better Auth for cookies/redirects.
BETTER_AUTH_URL=http://localhost:8787

# Optional: trusted frontend origin for CORS (dev). Comma-separated.
# Must match the origin the Next.js dev server is served from so the browser
# sends credentials cross-origin (httpOnly session cookie).
FRONTEND_ORIGIN=http://localhost:3000

# Base URL used to build invite links in invitation emails (distinct from
# FRONTEND_ORIGIN, which only controls CORS). Must be reachable by invitees.
FE_URL=http://localhost:3000

# Resend — optional for dev. When unset, invite emails are written to
# backend/logs/invites.log instead. For dev, use a Resend sandbox API key
# (https://resend.com/api-keys) — sandbox emails land in Resend's fake inbox.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# From-address for invitation emails. Resend sandbox sender works without DNS
# setup; custom-domain senders are wired in a follow-up ticket.
RESEND_FROM="SpendFlow <onboarding@resend.dev>"

# Session lifetime in seconds (default 7 days). Mirrors Better Auth's default.
SESSION_EXPIRES_IN=604800

# Port the Hono server listens on.
PORT=8787
