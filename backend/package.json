{
  "name": "spendflow-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SpendFlow Phase 1 backend — Better Auth + Drizzle + SQLite (BE-auth, ticket #10).",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@better-auth/drizzle-adapter": "^1.2.16",
    "@hono/node-server": "^1.13.7",
    "better-auth": "^1.2.16",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14",
    "resend": "^6.18.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
