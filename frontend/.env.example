# SpendFlow frontend environment.
# Copy to `.env.local` and adjust. Never commit the real `.env.local`.

# Backend base URL (Better Auth + REST API). Used by lib/auth/apiClient.ts and
# lib/api/fetch.ts. Defaults to http://localhost:8787 — the Hono dev server port.
NEXT_PUBLIC_BE_URL=http://localhost:8787

# SECURITY: dev-only login presets. When set to "1", the /login page shows
# three "demo role" buttons that pre-fill the seeded credentials
# (email + password still required). Default 0/unset = presets hidden, only the
# real email+password form is shown. Do NOT enable in production.
NEXT_PUBLIC_SPENDFLOW_DEV_PRESETS=0
